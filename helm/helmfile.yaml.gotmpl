# Every chart of the cluster, as one reconcile. Ansible runs helmfile apply
# on the first node, for a new cluster and a running one alike: it upgrades
# only the releases whose manifests changed, each once the releases it needs
# are ready, and rolls back one that fails.
#
# The nodes pull every image from the registry on each node. On a new
# cluster it goes first, from the archive Ansible put on each node, then the
# prepull puts every image on every node. On a running cluster the prepull
# goes first, so the nodes have a new registry image before the old one
# stops. REGISTRY_PRESENT says which.
#
# The secrets come from the environment, which Ansible sets. PG_RESTORE
# true adds pg-restore, a second cluster restored from pg's backups.
{{- $v := readFile "../versions/versions.yaml" | fromYaml }}
{{- $present := eq (requiredEnv "REGISTRY_PRESENT") "true" }}
{{- $restore := eq (env "PG_RESTORE") "true" }}
{{- $ca := requiredEnv "COMPANY_CA" }}

helmDefaults:
  wait: true
  atomic: true
  createNamespace: true
  timeout: 900

releases:
  - name: registry
    namespace: registry
    chart: ./charts/registry
    needs: {{ if $present }}[registry/prepull]{{ else }}[]{{ end }}
    values:
      - values/registry.yaml
      - image: {{ $v.registry.image | toJson }}
        ca: {{ $ca | toJson }}
        httpSecret: {{ requiredEnv "REGISTRY_HTTP_SECRET" | toJson }}
        s3:
          accessKey: {{ requiredEnv "REGISTRY_S3_ACCESS_KEY" | toJson }}
          secretKey: {{ requiredEnv "REGISTRY_S3_SECRET_KEY" | toJson }}

  - name: prepull
    namespace: registry
    chart: ./charts/prepull
    needs: {{ if $present }}[]{{ else }}[registry/registry]{{ end }}
    values:
      - image: {{ $v.prepull.image | toJson }}
        versions: {{ omit $v "k3s" "charts" "lab" | toJson }}

  - name: cert-manager
    namespace: cert-manager
    chart: ./charts/cnpg-cert-manager
    needs: [registry/prepull]
    values:
      - cert-manager-chart: {{ index $v "cert-manager" | toJson }}

  - name: cnpg
    namespace: cnpg-system
    chart: ./charts/cnpg-cloudnative-pg
    needs: [registry/prepull]
    values:
      - cloudnative-pg-chart: {{ index $v "cloudnative-pg" | toJson }}

  # Its webhook's certificate is cert-manager's, and it serves CNPG.
  - name: barman-cloud
    namespace: cnpg-system
    chart: ./charts/cnpg-plugin-barman-cloud
    needs: [cert-manager/cert-manager, cnpg-system/cnpg]
    values:
      - plugin-barman-cloud: {{ index $v "plugin-barman-cloud" | toJson }}
      # The plugin reads its sidecar image only when it starts, so a new
      # one restarts it, before pg restarts its instances.
      - plugin-barman-cloud:
          podAnnotations:
            sidecar-image: {{ (index $v "plugin-barman-cloud").sidecarImage.tag | toJson }}

  - name: pg
    namespace: databases
    chart: ./charts/cnpg-cluster
    needs: [cnpg-system/barman-cloud]
    values:
      - values/cluster.yaml
      - values/pg.yaml
      - &pg
        postgresql:
          imageName: {{ $v.postgresql.imageName | toJson }}
        cluster:
          postgresUID: {{ $v.postgresql.postgresUID }}
          postgresGID: {{ $v.postgresql.postgresGID }}
        ca: {{ $ca | toJson }}
        acme:
          ca: {{ $ca | toJson }}
          eab:
            server:
              keyID: {{ requiredEnv "PG_SERVER_EAB_KID" | toJson }}
              hmac: {{ requiredEnv "PG_SERVER_EAB_HMAC" | toJson }}
            replication:
              keyID: {{ requiredEnv "PG_REPLICATION_EAB_KID" | toJson }}
              hmac: {{ requiredEnv "PG_REPLICATION_EAB_HMAC" | toJson }}
        objectStore:
          accessKeyID: {{ requiredEnv "BACKUP_S3_ACCESS_KEY" | toJson }}
          secretAccessKey: {{ requiredEnv "BACKUP_S3_SECRET_KEY" | toJson }}
{{- if $restore }}

  - name: pg-restore
    namespace: databases
    chart: ./charts/cnpg-cluster
    needs: [databases/pg]
    values:
      - values/cluster.yaml
      - values/pg.yaml
      - *pg
      - values/pg-restore.yaml
      - acme:
          eab:
            server:
              keyID: {{ requiredEnv "PG_RESTORE_SERVER_EAB_KID" | toJson }}
              hmac: {{ requiredEnv "PG_RESTORE_SERVER_EAB_HMAC" | toJson }}
            replication:
              keyID: {{ requiredEnv "PG_RESTORE_REPLICATION_EAB_KID" | toJson }}
              hmac: {{ requiredEnv "PG_RESTORE_REPLICATION_EAB_HMAC" | toJson }}
{{- end }}

  - name: otel-client
    namespace: otel
    chart: ./charts/otel-client
    needs: [cert-manager/cert-manager]
    values:
      - values/otel-client.yaml
      - ca: {{ $ca | toJson }}
        acme:
          eab:
            keyID: {{ requiredEnv "OTEL_CLIENT_EAB_KID" | toJson }}
            hmac: {{ requiredEnv "OTEL_CLIENT_EAB_HMAC" | toJson }}

  - name: otel-agent
    namespace: otel
    chart: ./charts/cnpg-opentelemetry-collector
    needs: [registry/prepull, otel/otel-client]
    values:
      - values/otel-agent.yaml
      - opentelemetry-collector-chart: {{ $v.agent | toJson }}

  - name: otel-cluster
    namespace: otel
    chart: ./charts/cnpg-opentelemetry-collector
    needs: [registry/prepull, otel/otel-client]
    values:
      - values/otel-cluster.yaml
      - opentelemetry-collector-chart: {{ $v.cluster | toJson }}
